{
  "name": "magpie-extension",
  "version": "0.5.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox --mv2",
    "preview": "vite --config preview/vite.config.ts",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox --mv2",
    "build:all": "wxt build && wxt build -b firefox --mv2",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox --mv2",
    "sign:firefox": "pwsh -NoProfile -File scripts/sign-firefox.ps1",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "merge:check": "node scripts/merge-check.ts",
    "icons": "node scripts/make-icons.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "mux.js": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "jsdom": "^30.1.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.0",
    "vite": "^8",
    "vitest": "^3.0.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.4"
  }
}
